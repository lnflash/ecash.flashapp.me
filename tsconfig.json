{
  "compilerOptions": {
    "module": "Preserve",
    "strict": false,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "src/*": ["src/*"],
      "app/*": ["*"],
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "pages/*": ["src/pages/*"],
      "assets/*": ["src/assets/*"],
      "boot/*": ["src/boot/*"],
      "stores/*": ["src/stores/*"],
      "vue$": ["node_modules/vue/dist/vue.runtime.esm-bundler.js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "types/**/*.d.ts"]
}
